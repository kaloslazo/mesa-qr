# copiar como .env y completar

NOMBRE_RESTAURANTE=La Esquina
MESAS=8
# cualquier texto largo; firma los qr de las mesas
SECRETO_QR=
# la url publica del tunel, para que los qr apunten ahi (vacio = la del navegador)
URL_PUBLICA=

# adaptador que arranca en cada puerto (se pueden cambiar en vivo desde /mozo)
CARTA=json
REPOSITORIO=sqlite
PAGOS=simulado
AVISOS=websocket
RELOJ=real
IA=respaldo
TRADUCTOR=fijo
CAMBIO=exchangerate

# carta en google sheets: archivo > compartir > publicar en la web > csv
CARTA_SHEETS_URL=

# ia gratis: las llaves se sacan en console.groq.com y aistudio.google.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_SEGUNDOS=30
